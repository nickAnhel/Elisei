{
  "title": "ELISEI Loadtest Containers",
  "uid": "elisei-loadtest-containers",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Container CPU usage (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\".*(server_loadtest|db|redis|neo4j|prometheus_loadtest|grafana_loadtest|k6_suite).*\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container memory working set (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".*(server_loadtest|db|redis|neo4j|prometheus_loadtest|grafana_loadtest|k6_suite).*\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Container network received (bytes/s)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{name=~\".*(server_loadtest|db|redis|neo4j|prometheus_loadtest|grafana_loadtest|k6_suite).*\"}[1m]))",
          "legendFormat": "{{name}}"
        }
      ]
    }
  ]
}
