{
  "title": "Nerdex Loadtest Redis",
  "uid": "nerdex-loadtest-redis",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Redis up",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        { "refId": "A", "expr": "redis_up" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Connected clients",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        { "refId": "A", "expr": "redis_connected_clients" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory used (bytes)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        { "refId": "A", "expr": "redis_memory_used_bytes" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commands processed per second",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        { "refId": "A", "expr": "rate(redis_commands_processed_total[1m])" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network throughput (bytes/s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus-loadtest" },
      "targets": [
        { "refId": "A", "expr": "rate(redis_net_input_bytes_total[1m])", "legendFormat": "input" },
        { "refId": "B", "expr": "rate(redis_net_output_bytes_total[1m])", "legendFormat": "output" }
      ]
    }
  ]
}
